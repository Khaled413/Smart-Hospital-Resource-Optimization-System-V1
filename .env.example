# ── Flask Application Configuration ────────────────────────────────
FLASK_ENV=dev
FLASK_APP=app.py

# Security Secret Key (Required in production, min 32 characters)
SECRET_KEY=change-this-to-a-very-strong-random-key-in-production-min-32-chars

# Database Configuration
# Local SQLite: sqlite:///instance/hospital.db
# PostgreSQL / Supabase / Neon: postgresql://postgres:password@localhost:5432/hospital
DATABASE_URL=sqlite:///instance/hospital.db

# Timezone Configuration (Standard IANA timezone name)
APP_TIMEZONE=Africa/Cairo

# Initial Administrator Credentials (Used on first-time database seed)
ADMIN_INITIAL_PASSWORD=Admin#2025!

# Hospital Operational Parameters
DEFAULT_CLEANING_BUFFER=10
DEFAULT_EMERGENCY_ESI=1
ENABLE_SMART_OVERBOOKING=false
MAX_OVERBOOKING_FACTOR=1.15
LP_MAX_PATIENTS_THRESHOLD=75
