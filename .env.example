# ── Flask Application Configuration ────────────────────────────────
FLASK_ENV=dev
FLASK_APP=app.py

# Security Secret Key (Required in production, minimum 32 random characters)
SECRET_KEY=change-this-to-a-very-strong-random-key-in-production-min-32-chars

# ── Database Configuration (Supabase PostgreSQL / SQLite) ──────────
# Runtime Database URL (Vercel Serverless):
# Use Supabase Transaction Pooler (Supavisor) on Port 6543 with sslmode=require
# Format: postgresql://[user].[project_ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
#
# IMPORTANT: If your password contains special characters like [ ] @ : ? / # %,
# you MUST URL-encode it using Python urllib.parse.quote_plus (e.g. P@ss#123 -> P%40ss%23123)
DATABASE_URL=postgresql://postgres.yourprojectref:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# Dedicated Migration Database URL (Alembic / CLI / Backups only):
# Use Direct Connection or Session Pooler on Port 5432
# Format: postgresql://postgres:[password]@db.[project_ref].supabase.co:5432/postgres?sslmode=require
MIGRATION_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.yourprojectref.supabase.co:5432/postgres?sslmode=require

# Local SQLite fallback (Unset DATABASE_URL to use local SQLite for dev/testing)
# DATABASE_URL=sqlite:///instance/hospital.db

# Timezone Configuration (Africa/Cairo standard for hospital operations)
APP_TIMEZONE=Africa/Cairo

# Demonstration Mode (Set true only for public read-only guest demo)
DEMO_MODE=false

# Initial Administrator Credentials (Used once by explicit `flask seed` command)
ADMIN_INITIAL_PASSWORD=Admin#2025!
MANAGER_INITIAL_PASSWORD=Manager#2025!
DOCTOR_INITIAL_PASSWORD=Doctor#2025!
RECEPTIONIST_INITIAL_PASSWORD=Reception#2025!
DEMO_PASSWORD=DemoViewer#2025!

# Hospital Operational Parameters
DEFAULT_CLEANING_BUFFER=10
DEFAULT_EMERGENCY_ESI=1
ENABLE_SMART_OVERBOOKING=false
MAX_OVERBOOKING_FACTOR=1.15
LP_MAX_PATIENTS_THRESHOLD=75
