{
  "$schema": "https://pg-language-server.com/latest/schema.json",
  // Database configuration:
  // Connection details (PGHOST, PGPORT, PGUSER, PGDATABASE, PGPASSWORD) are read
  // dynamically from environment variables to avoid exposing project references in public repos.
  "db": {
    "connTimeoutSecs": 15,
    "disableConnection": false,
    // Database credentials and connection parameters are resolved from standard environment variables:
    // PGHOST, PGPORT, PGUSER, PGDATABASE, PGPASSWORD (or DATABASE_URL).
    //
    // Safety guard: Statement execution is strictly disabled against remote production databases.
    // Only local targets would be permitted if specified (e.g. 127.0.0.1/*).
    "allowStatementExecutionsAgainst": []
  },
  // Static analysis, linting, and best-practice checks
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  // SQL semantic type-checking and schema resolution
  "typecheck": {
    "enabled": true,
    "searchPath": [
      "public"
    ]
  },
  // SQL formatting style configuration
  "format": {
    "lineWidth": 100,
    "indentSize": 2,
    "indentStyle": "spaces",
    "keywordCase": "upper",
    "constantCase": "upper"
  }
}
